#!/usr/bin/env python3
import os
import socket
import time
from datetime import datetime
from flask import Flask, jsonify, render_template_string
import redis

app = Flask(__name__)

REDIS_HOST = "{{ redis_host }}"
REDIS_PORT = int("{{ redis_port }}")
REDIS_PASSWORD = "{{ redis_password }}"
PROJECT_NAME = "{{ project_name }}"
ENV_NAME = "{{ env_name }}"

def get_redis_client():
    return redis.Redis(
        host=REDIS_HOST,
        port=REDIS_PORT,
        password=REDIS_PASSWORD,
        socket_connect_timeout=3,
        decode_responses=True
    )

HTML_TEMPLATE = """{% raw %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ansible + Terraform Infrastructure Automation</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        body { background: #0f172a; color: #f8fafc; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; }
        .card { background: #1e293b; border: 1px solid #334155; border-radius: 16px; padding: 36px; max-width: 640px; width: 100%; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5); }
        .badge { display: inline-block; background: #059669; color: #ffffff; font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 9999px; text-transform: uppercase; margin-bottom: 16px; }
        h1 { font-size: 24px; font-weight: 700; color: #38bdf8; margin-bottom: 8px; }
        p.subtitle { color: #94a3b8; font-size: 14px; margin-bottom: 24px; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
        .metric-box { background: #0f172a; border: 1px solid #334155; border-radius: 10px; padding: 16px; }
        .metric-label { font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; margin-bottom: 4px; }
        .metric-value { font-size: 18px; font-weight: 700; color: #f1f5f9; word-break: break-all; }
        .counter-box { background: linear-gradient(135deg, #2563eb, #7c3aed); border-radius: 12px; padding: 20px; text-align: center; margin-bottom: 24px; }
        .counter-label { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: #e0e7ff; }
        .counter-value { font-size: 48px; font-weight: 800; color: #ffffff; }
        .footer { font-size: 12px; color: #64748b; text-align: center; border-top: 1px solid #334155; padding-top: 16px; }
    </style>
</head>
<body>
    <div class="card">
        <span class="badge">Multi-AZ Infrastructure Active</span>
        <h1>Ansible + Terraform Infrastructure Automation</h1>
        <p class="subtitle">Highly available web service backed by AWS Application Load Balancer and Redis Cache.</p>
        
        <div class="counter-box">
            <div class="counter-label">Shared Distributed Requests (Stored in Redis)</div>
            <div class="counter-value">{{ views }}</div>
        </div>

        <div class="grid">
            <div class="metric-box">
                <div class="metric-label">Responding EC2 Node</div>
                <div class="metric-value">{{ hostname }}</div>
            </div>
            <div class="metric-box">
                <div class="metric-label">Node Private IP</div>
                <div class="metric-value">{{ private_ip }}</div>
            </div>
            <div class="metric-box">
                <div class="metric-label">Redis Cache Host</div>
                <div class="metric-value">{{ redis_host }}</div>
            </div>
            <div class="metric-box">
                <div class="metric-label">Redis Status</div>
                <div class="metric-value" style="color: {{ redis_color }}">{{ redis_status }}</div>
            </div>
        </div>

        <div class="footer">
            Project: {{ project }} &bull; Environment: {{ env }} &bull; Updated: {{ timestamp }}
        </div>
    </div>
</body>
</html>
{% endraw %}"""

@app.route("/")
def index():
    hostname = socket.gethostname()
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        private_ip = s.getsockname()[0]
        s.close()
    except Exception:
        private_ip = "127.0.0.1"

    redis_status = "Connected"
    redis_color = "#34d399"
    views = 1

    try:
        r = get_redis_client()
        views = r.incr("page_views")
    except Exception as e:
        redis_status = f"Error: {str(e)[:25]}"
        redis_color = "#f87171"

    return render_template_string(
        HTML_TEMPLATE,
        views=views,
        hostname=hostname,
        private_ip=private_ip,
        redis_host=REDIS_HOST,
        redis_status=redis_status,
        redis_color=redis_color,
        project=PROJECT_NAME,
        env=ENV_NAME,
        timestamp=datetime.utcnow().strftime("%Y-%m-%d %H:%M:%S UTC")
    )

@app.route("/healthz")
def healthz():
    try:
        r = get_redis_client()
        r.ping()
        return jsonify({
            "status": "healthy",
            "server": socket.gethostname(),
            "redis": "connected",
            "timestamp": time.time()
        }), 200
    except Exception as e:
        return jsonify({
            "status": "degraded",
            "server": socket.gethostname(),
            "redis_error": str(e)
        }), 503

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)